<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <!-- prolly-playground-service: a small Spring Boot backend that exposes the REAL
       engine to the web playground — build a tree of longs, watch which nodes a
       write mints (the spine), browse the node content-addressed store, and verify
       every node's name against its bytes. The JS playground simulates; this serves
       the actual implementation.

       Spring Boot is imported HERE, module-scoped: the repo BOM stays framework-free
       on purpose (the libraries must not drag a framework; only this service uses one). -->
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.prollygraph</groupId>
    <artifactId>prolly-parent</artifactId>
    <version>0.2.0-BETA</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>prolly-playground-service</artifactId>
  <name>Prolly Playground — real-engine backend</name>

  <properties>
    <!-- a runnable service, not a library: never deployed to a Maven repository -->
    <maven.deploy.skip>true</maven.deploy.skip>
    <spring-boot.version>4.0.6</spring-boot.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>io.github.prollygraph</groupId>
      <artifactId>dolthub-java-port</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <!-- the disk engines behind playground.store=file|rocks -->
      <groupId>io.github.prollygraph</groupId>
      <artifactId>prolly-storage</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <!-- Boot 4 starter-web no longer pulls the JSON starter transitively -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-json</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Serve the playground at / — copied at BUILD time from the single maintained
           copy in ../prolly-web-playground (never a second source in git). -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <executions>
          <execution>
            <id>bundle-playground</id>
            <phase>process-resources</phase>
            <goals><goal>copy-resources</goal></goals>
            <configuration>
              <outputDirectory>${project.build.outputDirectory}/static</outputDirectory>
              <resources>
                <resource>
                  <directory>${project.basedir}/../prolly-web-playground</directory>
                  <includes>
                    <include>write-path-explorer.html</include>
                    <include>write-path-explorer.*.js</include>
                  </includes>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <version>${spring-boot.version}</version>
        <executions>
          <execution>
            <goals><goal>repackage</goal></goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
